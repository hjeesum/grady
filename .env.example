# Copy this file to .env and fill in real values. Never commit .env.

# Adzuna API: register at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Reed API (added later): register at https://www.reed.co.uk/developers
REED_API_KEY=

# Email (step 7). For Gmail, use an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
# Optional: friends who also get the email, as a blind copy (commas or new lines).
SUBSCRIBERS=
# Optional: sign-up Sheet's web app address, including ?key=... (scripts/signup_sheet.gs).
SIGNUP_LIST_URL=
